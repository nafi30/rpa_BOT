# ==============================================================================
# RPA BOT CONFIGURATION
# ==============================================================================

# --- AdsPower Local API ---
# AdsPower desktop client must be open with Local API enabled.
# Default base URL is http://local.adspower.net:50325
ADSPOWER_API_BASE=http://local.adspower.net:50325
ADSPOWER_API_KEY=
ADSPOWER_PROFILE_IDS=
ROTATION_STRATEGY=round-robin
LEADS_PER_PROFILE=20

# AdsPower Profile ID (e.g., k123456) or Serial Number (e.g., 1)
ADSPOWER_PROFILE_ID=your_adspower_profile_id_here
ADSPOWER_SERIAL_NUMBER=

# --- CapSolver API ---
# Get your API key from https://dashboard.capsolver.com
CAPSOLVER_API_KEY=CAP-YOUR_KEY_HERE
CAPSOLVER_POLL_INTERVAL_MS=3000
CAPSOLVER_TIMEOUT_MS=60000

# Optional: Dedicated proxy for CapSolver (if not using ProxyLess)
# Format: http://username:password@ip:port or socks5://...
CAPSOLVER_PROXY=

# Decodo profile setup (required only for npm run setup:profiles)
DECODO_PROXY_HOST=gate.decodo.com
DECODO_PROXY_PORT=7000
DECODO_PROXY_USER=
DECODO_PROXY_PASSWORD=

# --- File Paths ---
# When set, npm start refreshes this public sheet before processing and stops on sync failure.
GOOGLE_SHEET_URL=
INPUT_LEADS_FILE=./leads.csv
# Only these listing domains are eligible for outreach; demo/test URLs are skipped.
ALLOWED_LEAD_DOMAINS=apartments.com,hotpads.com
OUTPUT_RESULTS_FILE=./results.csv
SCREENSHOTS_DIR=./screenshots

# --- Operational Settings ---
# Delay between processing successive leads (milliseconds)
DELAY_BETWEEN_LEADS_MIN_MS=5000
DELAY_BETWEEN_LEADS_MAX_MS=12000

# Keystroke typing delay (milliseconds)
TYPING_DELAY_MIN_MS=45
TYPING_DELAY_MAX_MS=135

# Human action pause before clicking (milliseconds)
ACTION_PAUSE_MIN_MS=600
ACTION_PAUSE_MAX_MS=1800

# Page navigation timeout (milliseconds)
NAVIGATION_TIMEOUT_MS=45000

# Headless mode override (leave false to visually verify inside AdsPower)
HEADLESS=false

# --- Sender Identity ---
# Set exactly eight distinct inboxes, in rotation order. Never commit real addresses.
SENDER_NAME=Hassam Abbas
SENDER_COMPANY=Coastland Properties
SENDER_PHONE=
SENDER_EMAILS=sender1@example.com,sender2@example.com,sender3@example.com,sender4@example.com,sender5@example.com,sender6@example.com,sender7@example.com,sender8@example.com
# A blank sheet message uses the fixed initial corporate-lease inquiry in lib/spintaxEngine.js.
# Follow-up messages and reply handling must be configured in ManyReach separately.
